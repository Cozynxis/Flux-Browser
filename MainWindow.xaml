<Window x:Class="FluxBrowser.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Flux" Width="1400" Height="900" MinWidth="900" MinHeight="600" Background="{StaticResource FluxBg}" WindowStartupLocation="CenterScreen">
<Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#121319"><DockPanel Margin="10,5"><Button x:Name="NewTabButton" DockPanel.Dock="Right" Content="＋" Width="38" Click="NewTab_Click"/><TextBlock Text="FLUX" Foreground="White" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/><TextBlock x:Name="TabTitle" Text="  New Tab" Foreground="#C8CAD3" VerticalAlignment="Center"/></DockPanel></Border>
<Border Grid.Row="1" Background="{StaticResource FluxPanel}" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="←" Click="Back_Click"/><Button Grid.Column="1" Content="→" Click="Forward_Click"/><Button Grid.Column="2" Content="↻" Click="Reload_Click"/><TextBox x:Name="AddressBar" Grid.Column="3" Margin="8,0" VerticalContentAlignment="Center" FontSize="14" KeyDown="AddressBar_KeyDown"/><Button Grid.Column="4" Content="★" Click="Bookmark_Click"/><Button Grid.Column="5" Content="⋯" Click="Menu_Click"/></Grid></Border>
<wv2:WebView2 x:Name="Browser" Grid.Row="2"/>
</Grid></Window>