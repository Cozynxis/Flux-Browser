<Window x:Class="FluxBrowser.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Flux" Width="1500" Height="930" MinWidth="980" MinHeight="650" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#0B0C10">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Foreground" Value="#E9EAF0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="11,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#20222B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#30333E"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/></Style>
</Window.Resources>
<Border BorderBrush="#242631" BorderThickness="1" CornerRadius="10" Background="#101116"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
 <Grid Grid.Row="0" Background="#15161C" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="15,0"><Border Width="24" Height="24" CornerRadius="7" Background="#7C5CFC" VerticalAlignment="Center"><TextBlock Text="F" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="FLUX" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0"/></StackPanel><StackPanel x:Name="TabsPanel" Grid.Column="1" Orientation="Horizontal"/><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" Width="46" Click="Min_Click"/><Button Content="□" Width="46" Click="Max_Click"/><Button Content="×" Width="46" Click="Close_Click"/></StackPanel></Grid>
 <Grid Grid.Row="1" Background="#17181F" Margin="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Button Content="←" Click="Back_Click"/><Button Grid.Column="1" Content="→" Click="Forward_Click"/><Button Grid.Column="2" Content="↻" Click="Reload_Click"/><Button Grid.Column="3" Content="⌂" Click="Home_Click"/><Border Grid.Column="4" CornerRadius="12" Background="#20222B" Margin="5,6"><TextBox x:Name="AddressBar" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" KeyDown="AddressBar_KeyDown"/></Border><Button Grid.Column="5" Content="☆" Click="Bookmark_Click"/><Button Grid.Column="6" Content="＋" Click="NewTab_Click"/><Button Grid.Column="7" Content="⋯" Click="Menu_Click"/></Grid>
 <Grid Grid.Row="2"><Grid x:Name="BrowserHost"/><Grid x:Name="NewTab" Background="#0D0E13"><StackPanel Width="760" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="Greeting" Text="Welcome to Flux" Foreground="White" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="Clock" Foreground="#A8ABB8" FontSize="18" HorizontalAlignment="Center" Margin="0,8,0,32"/><Border Background="#1B1D25" CornerRadius="18"><TextBox x:Name="NewTabSearch" Height="58" FontSize="17" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Text="Search the web" GotFocus="NewTabSearch_GotFocus" KeyDown="NewTabSearch_KeyDown"/></Border><WrapPanel x:Name="QuickLinks" HorizontalAlignment="Center" Margin="0,24"><Button Content="YouTube" Tag="https://youtube.com" Click="QuickLink_Click"/><Button Content="GitHub" Tag="https://github.com" Click="QuickLink_Click"/><Button Content="Wikipedia" Tag="https://wikipedia.org" Click="QuickLink_Click"/><Button Content="Reddit" Tag="https://reddit.com" Click="QuickLink_Click"/></WrapPanel><TextBlock Text="Customize Flux from the ••• menu" Foreground="#666A78" HorizontalAlignment="Center" Margin="0,28"/></StackPanel></Grid></Grid>
 <Grid Grid.Row="3" Background="#121319"><TextBlock x:Name="StatusText" Text="Flux ready" Foreground="#747887" FontSize="11" Margin="10,0" VerticalAlignment="Center"/></Grid>
</Grid></Border></Window>