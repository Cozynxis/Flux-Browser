<Window x:Class="FluxBrowser.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Flux Browser" Width="1500" Height="920" MinWidth="1050" MinHeight="680" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#07070C">
<Window.Resources>
<SolidColorBrush x:Key="Accent" Color="#FF174F"/><SolidColorBrush x:Key="Panel" Color="#11111A"/><SolidColorBrush x:Key="Panel2" Color="#171721"/>
<Style x:Key="IconButton" TargetType="Button"><Setter Property="Foreground" Value="#EDEDF5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="17"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#252536"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Background" Value="#171721"/><Setter Property="Margin" Value="6"/><Setter Property="MinWidth" Value="105"/><Setter Property="Height" Value="72"/></Style>
<Style TargetType="TextBox"><Setter Property="Foreground" Value="#F4F4FA"/><Setter Property="CaretBrush" Value="#FF174F"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/></Style>
</Window.Resources>
<Grid>
<Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.RowSpan="3" Background="#090910" BorderBrush="#2A1020" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions><TextBlock Text="F" Foreground="#FF174F" FontWeight="Black" FontStyle="Italic" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Row="1"><Button Style="{StaticResource IconButton}" Content="⌂" ToolTip="New tab" Click="Home_Click"/><Button Style="{StaticResource IconButton}" Content="★" ToolTip="Bookmarks" Click="BookmarksPanel_Click"/><Button Style="{StaticResource IconButton}" Content="◷" ToolTip="History" Click="HistoryPanel_Click"/><Button Style="{StaticResource IconButton}" Content="↓" ToolTip="Downloads" Click="DownloadsPanel_Click"/><Button Style="{StaticResource IconButton}" Content="▣" ToolTip="Gaming hub" Click="GamingPanel_Click"/></StackPanel><StackPanel Grid.Row="2" VerticalAlignment="Bottom"><Button Style="{StaticResource IconButton}" Content="⚙" ToolTip="Settings" Click="SettingsPanel_Click"/><Button Style="{StaticResource IconButton}" Content="⋯" ToolTip="Flux menu" Click="Menu_Click"/></StackPanel></Grid></Border>
<Grid Grid.Column="1" Background="#0C0C13" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="TabsPanel" Orientation="Horizontal" Margin="8,3"/></ScrollViewer><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource IconButton}" Content="—" Width="48" Click="Min_Click"/><Button Style="{StaticResource IconButton}" Content="□" Width="48" Click="Max_Click"/><Button Style="{StaticResource IconButton}" Content="×" Width="48" Click="Close_Click"/></StackPanel></Grid>
<Border Grid.Row="1" Grid.Column="1" Background="#0E0E16" BorderBrush="#27101B" BorderThickness="0,0,0,1"><Grid Margin="8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Button Style="{StaticResource IconButton}" Content="‹" Click="Back_Click"/><Button Grid.Column="1" Style="{StaticResource IconButton}" Content="›" Click="Forward_Click"/><Button Grid.Column="2" Style="{StaticResource IconButton}" Content="↻" Click="Reload_Click"/><Border Grid.Column="3" Background="#171721" BorderBrush="#3A1727" BorderThickness="1" CornerRadius="16" Margin="6,0"><Grid><TextBlock Text="⌕" Foreground="#777787" FontSize="18" Margin="15,0" VerticalAlignment="Center"/><TextBox x:Name="AddressBar" Margin="42,0,15,0" VerticalContentAlignment="Center" KeyDown="AddressBar_KeyDown"/></Grid></Border><Button Grid.Column="4" Style="{StaticResource IconButton}" Content="☆" Click="Bookmark_Click"/><Button Grid.Column="5" Style="{StaticResource IconButton}" Content="＋" Click="NewTab_Click"/></Grid></Border>
<Grid Grid.Row="2" Grid.Column="1"><Grid x:Name="BrowserHost"/>
<Grid x:Name="NewTab" Background="#090910"><Grid><Grid.Background><RadialGradientBrush Center="0.5,0.25" RadiusX="0.8" RadiusY="0.8"><GradientStop Color="#35101D" Offset="0"/><GradientStop Color="#0A0910" Offset="0.55"/><GradientStop Color="#07070B" Offset="1"/></RadialGradientBrush></Grid.Background><StackPanel Width="850" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="FLUX" Foreground="White" FontSize="68" FontWeight="Black" FontStyle="Italic" HorizontalAlignment="Center"/><TextBlock x:Name="Greeting" Text="BROWSE YOUR WAY" Foreground="#FF174F" CharacterSpacing="400" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14"/><TextBlock x:Name="Clock" Foreground="#9292A1" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,25"/><Border Background="#14141E" BorderBrush="#5A1830" BorderThickness="1" CornerRadius="22" Height="58"><Grid><TextBlock Text="⌕" Foreground="#FF174F" FontSize="22" Margin="20,0" VerticalAlignment="Center"/><TextBox x:Name="NewTabSearch" Margin="55,0,20,0" FontSize="16" VerticalContentAlignment="Center" Text="Search the web or enter an address" GotFocus="NewTabSearch_GotFocus" KeyDown="NewTabSearch_KeyDown"/></Grid></Border><WrapPanel x:Name="QuickLinks" HorizontalAlignment="Center" Margin="0,22"><Button Style="{StaticResource CardButton}" Content="▶  YouTube" Tag="https://youtube.com" Click="QuickLink_Click"/><Button Style="{StaticResource CardButton}" Content="◉  Discord" Tag="https://discord.com" Click="QuickLink_Click"/><Button Style="{StaticResource CardButton}" Content="◆  Roblox" Tag="https://roblox.com" Click="QuickLink_Click"/><Button Style="{StaticResource CardButton}" Content="◈  GitHub" Tag="https://github.com" Click="QuickLink_Click"/><Button Style="{StaticResource CardButton}" Content="＋  Add" Click="SettingsPanel_Click"/></WrapPanel><Border Background="#11111A" BorderBrush="#282836" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FLUX GAMING" Foreground="#FF174F" FontWeight="Bold"/><TextBlock Text="Your gaming browser. Fast. Personal. Yours." Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="Customize the new tab, shortcuts and search without leaving the browser." Foreground="#858594"/></StackPanel><Button Grid.Column="1" Style="{StaticResource CardButton}" Content="CUSTOMIZE  ›" Click="SettingsPanel_Click"/></Grid></Border></StackPanel></Grid></Grid>
<Border x:Name="SidePanel" Width="390" HorizontalAlignment="Right" Background="#F20D0D15" BorderBrush="#421526" BorderThickness="1,0,0,0" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock x:Name="PanelTitle" Text="Flux" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="22,0" VerticalAlignment="Center"/><Button Style="{StaticResource IconButton}" Content="×" HorizontalAlignment="Right" Width="52" Click="ClosePanel_Click"/></Grid><ScrollViewer Grid.Row="1"><StackPanel x:Name="PanelContent" Margin="20"/></ScrollViewer></Grid></Border>
</Grid></Grid></Window>